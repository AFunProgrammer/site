<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('./partials/head.ejs') %>
    <%- include('./partials/head-scripts.ejs') %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
      .blog-background {
          position: fixed;
          top: 0;
          left: 0;
          width: 100vw;
          height: 100vh;
          background-image: <%= blogData.imageName ? `url("/images/blog/backgrounds/${blogData.imageName}.svg")` : 'none' %>;
          background-size: <%- blogData.fillStyle || 'cover' %>;
          background-repeat: no-repeat;
          background-position: center center;
          opacity: <%- blogData.opacity ?? 1 %>;
      }
      .ql-container {
          border: none!important; 
      }
      .blog-content {
        margin-top: 2rem;
        background-color: transparent;
        border: none;
      }
    </style>
  </head>

  <body style="background-color: <%-blogData.backColor%>">
    <div id="blog-background" class="blog-background"></div>    
    <%- include('./partials/nav.ejs') %>
    <div class="container align-content-center justify-content-center mt-5" style="position:relative;max-width: 1000px;">
      <div class="row mt-3">
        <div class="col text-center">
          <button type="button" class="btn btn-primary <%=blogData.previousEntry ? '' : 'd-none'%>" onclick="previousEntry()">
            <i class="bi bi-arrow-left"></i> Previous
          </button>
        </div>
        <div class="col text-center">
          <div class="text-center h1"><%=blogData.title%></div>
        </div>
        <div class="col text-center">
          <% if (blogData.nextEntry) { %>
            <button type="button" class="btn btn-primary" onclick="nextEntry()">
              Next <i class="bi bi-arrow-right"></i>
            </button>
          <% } %>
        </div>
      </div>
      <div class="row">
          <div class="text-center">by: <%=blogData.username %></div>
      </div>
      <div class="row mx-auto <%=blogOwnerShow%>">
        <div class="col mx-auto text-end <%=blogOwnerShow%>">
          <button type="button" class="btn btn-primary <%=blogOwnerShow%>" onclick="editBlog()">Edit</button>
        </div>
        <div class="col mx-auto text-start <%=blogOwnerShow%>">
          <button type="button" class="btn btn-primary <%=blogOwnerShow%>" onclick="deleteBlog()">Delete</button>
        </div>
      </div>
      <div class="row">
        <div class="ql-snow"><div class="ql-editor"><%- blogData.content %></div></div>
      </div>
    </div>

    <script>
      const blogEditUrl = <%- JSON.stringify(blogEditUrl || "") %>;
      const blogViewUrl = <%- JSON.stringify(blogViewUrl || "") %>;
      const previousBlogEntry = <%- JSON.stringify(blogData.previousEntry || "") %>;
      const nextBlogEntry = <%- JSON.stringify(blogData.nextEntry || "") %>;


      function previousEntry(){
        // Send previous date (if it exists) to a REST endpoint to get the previous blog entry
        if ( !previousBlogEntry || blogViewUrl == "" ){
          return;
        }
        window.location.href = `${blogViewUrl}${previousBlogEntry}`;
      }
      function nextEntry(){
        // Send next date (if it exists) to a REST endpoint to get the next blog entry
        if ( !nextBlogEntry || blogViewUrl == "" ){
          return;
        }
        window.location.href = `${blogViewUrl}${nextBlogEntry}`;
      }

      // Function to handle the edit button click
      // This function will redirect to the edit page if the URL is set
      // If the URL is not set, it will do nothing
      function editBlog(){
        if ( blogEditUrl && blogEditUrl != "" ){
          window.location.href = blogEditUrl;
        }
      }

      async function deleteBlog() {
        if (!blogEditUrl) {
          return;
        }

        if (!confirm("Are you sure you want to delete this blog?")) {
          return;
        }

        try {
          const response = await fetch(blogEditUrl, { method: 'DELETE' });
          const rawText = await response.text();

          let data = null;
          try {
            data = rawText ? JSON.parse(rawText) : null;
          } catch (parseErr) {
            // Response wasn't JSON (e.g., plain text or HTML error page)
          }

          if (!response.ok) {
            console.error('Delete failed:', {
              url: blogEditUrl,
              method: 'DELETE',
              status: response.status,
              statusText: response.statusText,
              body: data ?? rawText
            });

            if (data?.redirectUrl) {
              window.location.href = data.redirectUrl;
              return;
            }

            alert(data?.message || `Delete failed (${response.status} ${response.statusText})`);
            return;
          }

          if (data?.redirectUrl) {
            window.location.href = data.redirectUrl;
          }
        } catch (networkErr) {
          // True network/fetch failure (no HTTP response received)
          console.error('Network error while deleting:', {
            url: blogEditUrl,
            method: 'DELETE',
            error: networkErr
          });
          alert('Network error while trying to delete the blog.');
        }
      }

      function decodeHtml(html) {
        var txt = document.createElement("textarea");
        txt.innerHTML = html;
        return txt.value;
      }

    </script>
    <%- include('./partials/body-script.ejs') %>
    <%- include('./partials/footer.ejs') %>
  </body>
</html>
